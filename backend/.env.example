# Kopiere diese Datei zu .env (lokal) bzw. trage die Werte in Render unter "Environment" ein.

PORT=10000

# MySQL (z. B. PlanetScale, Aiven, eigener Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=brotsmp
DB_PASSWORD=bitte-eintragen
DB_NAME=brotsmp
DB_SSL=false

# Langer, zufälliger Schlüssel, z. B. mit: openssl rand -hex 64
JWT_SECRET=bitte-langen-zufaelligen-wert-eintragen

# Erlaubte Website(s), kommagetrennt, z. B. https://brotsmp1.onrender.com
ALLOWED_ORIGINS=https://brotsmp1.onrender.com
